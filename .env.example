# What your bot's discord key is
DISCORD_KEY=key_goes_here
# Optional: path to the bot config, defaults to config/model-citizen.toml
# (docker-compose sets this to /config/model-citizen.toml)
#MODEL_CITIZEN_CONFIG=config/model-citizen.toml
# Optional: where the bot reaches the llm's grpc server, defaults to
# localhost:50051 (docker-compose sets this to llm:50051)
#LLM_ADDRESS=localhost:50051

# Provider keys, named by api_key_env in config/llm.toml. Every one that
# config/llm.toml uses must be set or the llm won't start.

# NVIDIA NIM (chat)
MODEL_AUTH_KEY=key_goes_here
# Groq (chat)
GROQ_KEY=key_goes_here
# Ollama Cloud (chat)
OLLAMA_MODEL_KEY=key_goes_here
# Deepgram (speech to text): $200 of credit that does not expire, ~775 hours of nova-3
DEEPGRAM_KEY=key_goes_here
# Mistral (speech to text with Voxtral)
MISTRAL_KEY=key_goes_here
# AssemblyAI (speech to text): 185 free hours, but it queues a clip instead of
# answering, so it sits last in the rotation
ASSEMBLYAI_KEY=key_goes_here
# Google Cloud Text-to-Speech: an API key restricted to that API, from a
# project with billing enabled; the first million characters a month of a
# Chirp 3 HD voice are free
GOOGLE_KEY=key_goes_here
