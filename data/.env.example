# What your bot's discord key is
DISCORD_KEY=key_goes_here
# Referenced by name from data/models.json (auth_key), one variable per service
MODEL_AUTH_KEY=key_goes_here
# Fallback single model, used only when models.json is missing or unusable
MODEL_NAME=model_name
# Fallback api link for a model to use
MODEL_LINK=https://aimodellink.link
# Optional: path to the rotation file, defaults to models.json
MODEL_FILE=models.json
