# What your bot's discord key is
DISCORD_KEY=key_goes_here
# Referenced by name from data/text-models.json and data/voice-models.json
# (auth_key), one variable per service
MODEL_AUTH_KEY=key_goes_here
MISTRAL_KEY=key_goes_here
# Groq: free tier covers whisper-large-v3-turbo and whisper-large-v3
GROQ_KEY=key_goes_here
# Scaleway generative APIs: 60 free audio minutes a month
SCALEWAY_KEY=key_goes_here
# Fallback single model, used only when text-models.json is missing or unusable
MODEL_NAME=model_name
# Fallback api link for a model to use
MODEL_LINK=https://aimodellink.link
# Optional: paths to the rotation files
MODEL_FILE=text-models.json
VOICE_MODEL_FILE=voice-models.json
# Optional: the wake word. Defaults suit the container; for a local run point
# ONNXRUNTIME_LIB at an unpacked onnxruntime release (see wakeword/README.md)
ONNXRUNTIME_LIB=/usr/local/lib/libonnxruntime.so
WAKE_DIR=wakeword
# Score that counts as the wake word, 0-1. Lower hears more and false-triggers
# more; "wake word near miss" log lines show what real speech scores.
WAKE_THRESHOLD=0.2
# Optional: /transcribe also saves each utterance it heard here as 16kHz
# wav, for scoring the wake word offline on real Discord audio. Unset to
# keep nothing. Compose mounts data/voice-dumps at /app/voice-dumps.
#VOICE_DUMP_DIR=/app/voice-dumps
